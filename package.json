{
  "name": "apex",
  "version": "0.1.0",
  "description": "Jogo de carreira de F1: do karting à glória. Engine de simulação isomórfica (Node + navegador).",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "balance": "node tools/balance.js",
    "build": "node tools/build-ui.js",
    "events": "node tools/export-events.js",
    "dev": "node tools/build-ui.js && npx serve dist",
    "serve": "node tools/serve.mjs",
    "calibrate:player": "node tools/calibrate/player.js",
    "calibrate:champions": "node tools/calibrate/champions.js",
    "calibrate:veterans": "node tools/calibrate/veterans.js",
    "calibrate:age": "node tools/calibrate/start-age.js",
    "test:ui": "playwright test"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "esbuild": "^0.28.2"
  }
